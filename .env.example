# Google Gemini (AI Studio API key — get from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Optional: override default model (gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Zoho CRM (read-only OAuth — see README for refresh token instructions)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Adjust per data center: zohoapis.com / zohoapis.eu / zohoapis.in / zohoapis.com.au
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# Frontend → agent connection
AGENT_URL=http://localhost:8124

# Optional LangSmith tracing
LANGSMITH_API_KEY=
